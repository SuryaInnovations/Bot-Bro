# ==============================================================================
# NOVA AI — PRODUCTION PUBLIC BETA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Intelligence Engine (Official Anthropic Claude API)
# Required for Claude 3.7 Sonnet dynamic hybrid reasoning & agent swarms.
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_PRODUCTION_KEY_HERE

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL for external webhook callbacks & OAuth redirects
NEXT_PUBLIC_SITE_URL=https://bot-bro-one.vercel.app
NEXT_PUBLIC_APP_URL=https://nova.ai

# Production PostgreSQL Database & Row Level Security (Supabase)
# Required for tenant isolation, persistent user memory, and background queues.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_KEY

# Security & Authentication Secrets
# Used for session token encryption and CSRF cookie hashing
JWT_SECRET=generate_strong_64_character_random_hex_string_here
SESSION_COOKIE_NAME=nova_session_token
SESSION_MAX_AGE_DAYS=7

# External Integrations (Optional / Fallback enabled)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Telemetry & Security Monitoring
ENABLE_SECURITY_EVENT_LOGGING=true
MAX_REQUESTS_PER_MINUTE=60
