# ============================================================
# NOVA AI — Environment Configuration
# ============================================================

# Official Anthropic Claude API Key (Required for AI responses)
# Obtain your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Claude Model ID
ANTHROPIC_DEFAULT_MODEL=claude-3-7-sonnet-20250219

# Optional: Supabase Database & Auth (Optional: local storage fallback active by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Dedicated Web Search API (Optional: fallback engine active by default)
BRAVE_SEARCH_API_KEY=
